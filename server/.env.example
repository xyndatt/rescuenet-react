PORT=4000
NODE_ENV=development
FIREBASE_DATABASE_URL=https://rescuenet-650cf-default-rtdb.firebaseio.com
# Use ONE of these two:
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}   (for hosts where you can't upload a file)
# Photos: 'rtdb' = free (stored in the Realtime Database), 'storage' = Firebase Storage (needs the Blaze plan)
PHOTO_STORAGE=rtdb
# Only needed when PHOTO_STORAGE=storage. Storage bucket name shown in Firebase console > Storage (e.g. rescuenet-650cf.firebasestorage.app or rescuenet-650cf.appspot.com)
FIREBASE_STORAGE_BUCKET=rescuenet-650cf.firebasestorage.app
CORS_ORIGIN=http://localhost:5173
# Set to 1 when behind a proxy / load balancer (Render, Railway, Nginx...) so rate limits see real IPs
TRUST_PROXY=0
# Enables demo-only endpoints (simulate rescue-team app, reset data). Keep false in production.
DEMO_MODE=true

# Resident becomes INVALID after this many reports marked as FALSE by the admin (1 = immediately, 2 = second false report)
FALSE_REPORT_LIMIT=2
