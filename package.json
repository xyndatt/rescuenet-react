{
  "name": "rescuenet-react",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "postinstall": "npm --prefix server install",
    "setup": "node scripts/setup.mjs",
    "seed": "npm --prefix server run seed",
    "reset-minimal": "npm --prefix server run reset-minimal --",
    "api": "npm --prefix server run dev",
    "dev:all": "concurrently -k -n api,web -c blue,green \"npm run api\" \"npm run dev\""
  },
  "dependencies": {
    "firebase": "^10.14.1",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^3.8.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^5.4.0",
    "concurrently": "^8.2.2"
  }
}