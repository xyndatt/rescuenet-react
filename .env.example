# Copy to .env  (Firebase console > Project settings > Your apps > Web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=rescuenet-650cf.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://rescuenet-650cf-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=rescuenet-650cf
# Only needed if you use Firebase Storage for photos (Blaze plan). Leave empty otherwise.
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
# Optional: browser push alerts (Firebase console > Project settings > Cloud Messaging)
#   sender id = "Sender ID"; VAPID key = Web Push certificates > Generate key pair
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_VAPID_KEY=
# Where the Express backend runs (used by the report form)
# Base URL of the Express backend (no /api)
VITE_API_URL=http://localhost:4000
